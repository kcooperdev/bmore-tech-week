# Admin dashboard password for /admin
# Local default is bmore-admin if this is unset.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# One Google Sheet with Hosts / Speakers / Volunteers tabs.
# Paste the Apps Script from scripts/btw-google-sheet.gs, deploy as a web app,
# then put the URL and the same secret here (and in Vercel).
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SECRET=

# Ticket reminders. Verify bmoretechweek.com in Resend, then paste these here and in Vercel.
# RESEND_FROM must use that verified domain. RESEND_SEGMENT_ID is the Ticket reminders segment.
RESEND_API_KEY=
RESEND_FROM=Baltimore Tech Week <team@bmoretechweek.com>
RESEND_SEGMENT_ID=
